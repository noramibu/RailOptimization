{
  "schema_version": 1,
  "quilt_loader": {
    "group": "me.noramibu",
    "id": "railoptimization",
    "version": "${version}",
    "metadata": {
      "name": "RailOptimization",
      "description": "A simple mod that makes powered/activator rails turn on/off up to 4x faster",
      "contributors": {
        "noramibu": "Owner",
        "FX - PROCESS": "Original author",
        "EasterGhost": "Maintainer"
      },
      "contact": {
        "homepage": "https://github.com/noramibu/RailOptimization/",
        "sources": "https://github.com/noramibu/RailOptimization/"
      },
      "license": "LGPL-3.0",
      "icon": "assets/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "mixins": [
      "railoptimization.mixins.json"
    ],
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=${quilt_loader_version}"
      },
      {
        "id": "minecraft",
        "versions": "${minecraft_version}"
      }
    ]
  }
}
